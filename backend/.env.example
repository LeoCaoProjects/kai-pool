# Copy this file to `.env`, then replace the placeholder values.

SPRING_APPLICATION_NAME=kai-pool-backend
SERVER_PORT=8080

# Use `dev` to add the demo users and food.
SPRING_PROFILES_ACTIVE=dev

# Supabase: use the Session pooler values shown under Connect.
# Keep the jdbc: prefix, port 5432, and sslmode=require.
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.PROJECT_REFERENCE
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Use a long random value outside local development.
JWT_SECRET=replace-with-at-least-32-characters

# Gemini food recognition and collaborative meal suggestions. Keep the real key private.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=25
GEMINI_RECIPE_MODEL=gemini-3.5-flash-lite

# Meal photography. TheMealDB key 1 is intended for development and educational use.
# Add a supporter key before a public production release.
THEMEALDB_ENABLED=true
THEMEALDB_API_KEY=1

# Optional: generates at most one missing hero image per newly cached match.
# Leave blank to use the free TheMealDB/category fallbacks only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Maximum distance for Cook together matches.
MATCHING_MAX_DISTANCE_KM=30
