# Set these values in your terminal or IDE before starting Spring Boot.
# This file is a template and is not loaded automatically.

SPRING_APPLICATION_NAME=kai-pool-backend
SERVER_PORT=8080

# Use `dev` to connect to PostgreSQL and add demo data.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/kai_pool
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Use a long random value outside local development.
JWT_SECRET=replace-with-at-least-32-characters

# Add AI provider keys only after the provider is selected.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
